# Travel Diary AI — Example Configuration
# Copy to .env and edit values.

# Data directory for SQLite DB and derived assets
DATA_DIR=./data

# Server-side import allowlist (comma-separated absolute paths)
IMPORT_ROOTS=./imports

# The settings screen is the normal place to configure models, API keys, Ghost,
# location research, image processing, and upload limits. These variables seed
# defaults for a fresh install or can be used for a headless deployment.
# OMLX (OpenAI-compatible) API
# Docker Desktop host address; use 127.0.0.1 for a local non-container run.
OMLX_BASE_URL=http://host.docker.internal:8000/v1
OMLX_API_KEY=your-api-key-here
OMLX_WRITER_MODEL=gemma-4-e4b-it-4bit
# Optional separate vision model; defaults to OMLX_WRITER_MODEL.
OMLX_VISION_MODEL=
OMLX_TIMEOUT_SEC=180
OMLX_CONCURRENCY=1

# Optional location research. When disabled (default), the writer model supplies
# general destination context from its own knowledge. Enabling web search requires
# a Brave Search API key; its source snippets are used as grounding context.
LOCATION_WEB_SEARCH=false
BRAVE_SEARCH_API_KEY=

# Server
PORT=8080
LOG_LEVEL=info

# Image processing
THUMBNAIL_SIZE=400
PREVIEW_SIZE=1200
EXPORT_SIZE=2560
JPEG_QUALITY=85

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=500
MAX_UPLOAD_FILES=200

# Ghost Admin API (Milestone 5)
GHOST_URL=https://your-ghost-instance.com
GHOST_ADMIN_API_KEY=your-admin-api-key
