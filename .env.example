# Travel Diary AI — Example Configuration
# Copy to .env and edit values.

# Data directory for SQLite DB and derived assets
DATA_DIR=./data

# Server-side import allowlist (comma-separated absolute paths)
IMPORT_ROOTS=./imports

# OMLX (OpenAI-compatible) API
OMLX_BASE_URL=http://127.0.0.1:8000/v1
OMLX_API_KEY=your-api-key-here
OMLX_WRITER_MODEL=gemma-4-e4b-it-4bit
OMLX_TIMEOUT_SEC=180
OMLX_CONCURRENCY=1

# Server
PORT=8080
LOG_LEVEL=info

# Image processing
THUMBNAIL_SIZE=400
PREVIEW_SIZE=1200
EXPORT_SIZE=2560
JPEG_QUALITY=85

# Upload limits
MAX_FILE_SIZE_MB=50
MAX_UPLOAD_SIZE_MB=500
MAX_UPLOAD_FILES=200

# Ghost Admin API (Milestone 5)
GHOST_URL=https://your-ghost-instance.com
GHOST_ADMIN_API_KEY=your-admin-api-key
